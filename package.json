{
  "name": "node-server-template",
  "version": "4.0.0",
  "description": "Just universal server",
  "repository": "https://github.com/Vladinho10/node-server-template",
  "author": "Vlad Mkhitaryan",
  "license": "ISC",
  "keywords": [
    "swagger",
    "typescript",
    "express",
    "mongodb",
    "mongoose",
    "docker",
    "kubernetes",
    "jenkins",
    "template",
    "server",
    "nodemailer",
    "jsonwebtoken",
    "log4js",
    "morgan",
    "socket.io",
    "rabbitmq"
  ],
  "engines": {
    "node": "22.x"
  },
  "type": "commonjs",
  "main": "index.ts",
  "mocha": {
    "diff": true,
    "extension": [
      "js"
    ],
    "slow": "75",
    "timeout": "20000"
  },
  "scripts": {
    "start": "yarn run build; node ./dist/index.js",
    "build": "rm -rf ./dist; tsc",
    "nodemon": "tsc; ./node_modules/nodemon/bin/nodemon.js index",
    "test": "mocha ./test/*.e2e.js",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "rabbitmq:send": "yarn run build; node ./dist/rabbitmq/send.js",
    "rabbitmq:receive": "yarn run build; node ./dist/rabbitmq/receive.js"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "axios": "^1.13.2",
    "dotenv-flow": "^4.1.0",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "http-status": "^2.1.0",
    "images-to-pdf": "^1.0.3",
    "jiti": "^2.6.1",
    "jsonwebtoken": "^9.0.3",
    "log4js": "^6.9.1",
    "mongoose": "9.0.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "resolutions": {
    "@types/mime": "^1.0.0",
    "cross-spawn": "7.0.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.1",
    "@types/nodemailer": "^7.0.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "chai": "^6.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "mocha": "^11.7.5",
    "mock-fs": "^5.5.0",
    "nodemon": "^3.1.11",
    "pinst": "^3.0.0",
    "sinon": "^21.0.0",
    "typescript": "^5.9.3"
  }
}
